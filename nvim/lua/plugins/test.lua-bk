local M = {}

local Job = require("plenary.job")

-- Helper to get selected text in visual mode
local function get_visual_selection()
  local start_pos = vim.fn.getpos("'<")
  local end_pos = vim.fn.getpos("'>")
  local start_row, start_col = start_pos[2], start_pos[3]
  local end_row, end_col = end_pos[2], end_pos[3]
  local lines = vim.api.nvim_buf_get_lines(0, start_row - 1, end_row, false)

  if #lines == 0 then
    return nil
  end

  lines[1] = string.sub(lines[1], start_col)
  lines[#lines] = string.sub(lines[#lines], 1, end_col)

  return table.concat(lines, "\n")
end

-- Query the Ollama API
local function query_ollama_api(selected_code, callback)
  local json = vim.fn.json_encode({
    model = "qwen2.5:7b",
    messages = {
      {
        role = "user",
        content = "Explain the following code:\n" .. selected_code,
      },
    },
  })

  Job:new({
    command = "curl",
    args = {
      "-X",
      "POST",
      "http://127.0.0.1:11434/api/chat",
      "-H",
      "Content-Type: application/json",
      "-d",
      json,
    },
    on_exit = function(job, return_val)
      if return_val ~= 0 then
        vim.schedule(function()
          vim.notify(
            "Failed to query Ollama API: " .. table.concat(job:stderr_result(), "\n"),
            vim.log.levels.ERROR
          )
        end)
        return
      end

      local result = table.concat(job:result(), "\n")
      print("Raw API response: ", result)  -- Debugging line to print the raw response

      local messages = {}
      for line in result:gmatch("[^\r\n]+") do
        local success, decoded = pcall(vim.json.decode, line)
        if success and decoded and decoded.message and decoded.message.content then
          table.insert(messages, decoded.message.content)
        else
          vim.schedule(function()
            vim.notify("Failed to decode JSON response: " .. line, vim.log.levels.ERROR)
          end)
        end
      end

      local response = table.concat(messages, " ")

      vim.schedule(function()
        callback(response)
      end)
    end,
  }):start()
end

-- Create a floating window
local function create_floating_window(content)
  local buf = vim.api.nvim_create_buf(false, true)
  vim.api.nvim_buf_set_option(buf, 'bufhidden', 'wipe')
  vim.api.nvim_buf_set_lines(buf, 0, -1, false, vim.split(content, "\n"))

  -- Calculate the maximum line length
  local max_line_length = 0
  for _, line in ipairs(vim.split(content, "\n")) do
    if #line > max_line_length then
      max_line_length = #line
    end
  end

  -- Adjust the width based on the maximum line length
  local width = math.min(max_line_length + 4, vim.o.columns - 2)
  local height = math.floor(vim.o.lines * 0.8)

  local opts = {
    relative = "editor",
    width = width,
    height = height,
    col = vim.o.columns - width - 2,  -- Position the window on the right side
    row = math.floor((vim.o.lines - height) / 2),
    style = "minimal",
    border = "rounded",
  }
  vim.api.nvim_open_win(buf, true, opts)
end

-- Main function to execute the plugin
function M.ollama_popup()
  local selected_code = get_visual_selection()
  if not selected_code or selected_code == "" then
    vim.notify("No code selected!", vim.log.levels.ERROR)
    return
  end

  query_ollama_api(selected_code, function(response)
    create_floating_window(response)
  end)
end

vim.api.nvim_create_user_command("OllamaPopup", M.ollama_popup, { 
  range = true,
  desc = "Explain the selected code using the Ollama API"
})

return M